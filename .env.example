# Optional separate multiplayer server for a static client build.
# Leave unset for the normal same-origin local game.
VITE_GAME_SERVER_URL=
# Exact permitted frontend origin(s), comma-separated, on the Node server.
CLIENT_ORIGIN=
# Public Node hosting: set HOST=0.0.0.0 and use the provider-assigned PORT.
HOST=127.0.0.1
